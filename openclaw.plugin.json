{
  "id": "colab-provisioner",
  "name": "OpenClaw Colab Provisioner",
  "version": "1.3.0-beta.3",
  "description": "Google Colab runtime provisioning with optional MCP, OpenAI-compatible gateway, and on-demand GPU Autopilot.",
  "activation": {
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "mode": {
        "type": "string",
        "enum": [
          "observe",
          "manual"
        ],
        "default": "observe"
      },
      "telegramCommands": {
        "type": "boolean",
        "default": false
      },
      "allowedTelegramIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      }
    }
  }
}
